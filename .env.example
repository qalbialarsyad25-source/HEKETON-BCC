# Copy to .env: cp .env.example .env
# Every key is optional unless marked "required": an empty or missing key uses the default shown.
# Real environment variables (CI, Docker) always win over this file.
#
# Inside docker compose the app service pins the in-network values itself (DB_HOST=postgres,
# DB_PORT=5432, LOG_FILE_PATH=logs/app.log), so the values below are for `make run`.
#
# On the VM: create this file once by hand (cp .env.example .env), then change the values
# marked "VM:". The deploy job never touches it.

# ---------------------------------------------------------------- app
# DEV | TEST | PRODUCTION (any case). PRODUCTION turns on the safety checks marked "production" below.
# VM: APP_MODE=PRODUCTION
APP_MODE=DEV
# Also the prefix of every compose container name (<APP_NAME>-postgres, …).
APP_NAME=go-starter

# ---------------------------------------------------------------- database (postgres)
DB_HOST=localhost
DB_PORT=5432
# The same values create the database in the postgres container on its first start.
# VM: set a real DB_PASSWORD before the first `docker compose up` (it is fixed once the volume exists).
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app
# disable | require | verify-full …
DB_SSLMODE=disable

# ---------------------------------------------------------------- jwt
# Production refuses to start when a secret is the default, shorter than 32 bytes,
# or when both secrets are the same. Generate one with: openssl rand -base64 48
# VM: two different generated secrets.
JWT_ACCESS_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-secret-key
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# ---------------------------------------------------------------- bcrypt
# 4–31. Production requires at least 10.
BCRYPT_COST=10

# ---------------------------------------------------------------- logs
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json
LOG_ADD_SOURCE=true
LOG_FILE_PATH=logs/app.log
# Rotation: size in MB, number of old files, age in days.
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true

# ---------------------------------------------------------------- compose host ports
# Host port docker compose publishes postgres on (always bound to 127.0.0.1).
# Change it when another project already uses the port, and match DB_PORT for `make run`.
POSTGRES_HOST_PORT=5432
